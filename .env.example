# Copy to .env.local and adjust. Every setting is optional; the defaults work locally.
# Never commit real secrets: .env*.local files are git-ignored.

# Public URL of the site (used for Open Graph / social preview links).
# SITE_URL=https://listen.example.com

# Python interpreter that has the edge-tts package. `python server.py` sets this
# automatically to the interpreter you ran it with.
# PYTHON_BIN=python

# ffmpeg executable for M4A / MP4 export (default: "ffmpeg" on PATH).
# FFMPEG_BIN=ffmpeg

# Speech synthesis
# TTS_TIMEOUT_SECONDS=90
# TTS_MAX_CONCURRENCY=6          # parallel synthesis processes, server-wide
# CONVERT_MAX_CONCURRENCY=2      # parallel ffmpeg conversions, server-wide
# ENABLE_BACKUP_VOICE=true       # offer the (opt-in) backup voice when the main service fails

# Translation: "google" (default, free web endpoint, no key) or "libretranslate".
# TRANSLATE_PROVIDER=google
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Set to true ONLY when a reverse proxy (nginx, Caddy, a hosting platform) sits in
# front of the app and overwrites X-Forwarded-For / X-Forwarded-Host. Then rate
# limits apply per client IP and the cross-site check uses the public host name.
# Left unset, those headers are ignored (anyone could fake them) and all callers
# share one rate-limit budget.
# TRUST_PROXY=false

# Rate limits per minute (per client IP with TRUST_PROXY=true, otherwise shared).
# RATE_LIMIT_TTS_PER_MINUTE=240
# RATE_LIMIT_PREVIEW_PER_MINUTE=60
# RATE_LIMIT_TRANSLATE_PER_MINUTE=30
# RATE_LIMIT_CONVERT_PER_MINUTE=12

# Where generated voice previews are cached (sample sentences only).
# PREVIEW_CACHE_DIR=.cache/previews
