    "build": "next build",
    "start": "next start -p 3000",
    "postinstall": "node scripts/copy-vendor-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-check.mjs",
    "catalog": "node scripts/build-voice-catalog.mjs",
    "voices:refresh": "python scripts/save_voices.py && node scripts/build-voice-catalog.mjs"
  },
