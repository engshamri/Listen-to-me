{
  "name": "listen-to-me",
  "version": "1.0.0",
  "private": true,
  "description": "Listen to me (اسمعني) — multilingual text-to-speech and translation platform",
  "keywords": [
    "text-to-speech",
    "tts",
    "arabic",
    "rtl",
    "translation",
    "ocr",
    "edge-tts",
    "nextjs"
  ],
  "homepage": "https://github.com/engshamri/Listen_to_me#readme",
  "bugs": {
    "url": "https://github.com/engshamri/Listen_to_me/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engshamri/Listen_to_me.git"
  },
  "author": "Yousif AL_Shamri (https://github.com/engshamri)",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/copy-vendor-assets.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "postinstall": "node scripts/copy-vendor-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-check.mjs",
    "test:old-webkit": "node scripts/old-webkit-check.mjs",
    "catalog": "node scripts/build-voice-catalog.mjs",
    "voices:refresh": "python scripts/save_voices.py && node scripts/build-voice-catalog.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "^16.1.3",
    "fake-indexeddb": "^6.2.6",
    "flag-icons": "^7.6.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
